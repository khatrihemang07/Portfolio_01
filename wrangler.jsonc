{
  // Cloudflare Workers Builds runs `pnpm run build`, then `npx wrangler deploy`.
  // This is a static site: no Worker script, only the files in dist/ (including the
  // generated _headers file, which Workers static assets applies).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hemangkhatri",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
