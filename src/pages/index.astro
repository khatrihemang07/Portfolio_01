---
import { getCollection } from "astro:content";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Dock from "../components/Dock.astro";
import Hero from "../components/Hero.astro";
import ProjectBlock from "../components/ProjectBlock.astro";
import Ruler from "../components/Ruler.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);

const tints: Record<string, "pink" | "violet" | "teal"> = {
  markuli: "pink",
  Mnemora: "violet",
  localAIWrapper: "teal",
};
---

<BaseLayout>
  <main id="main">
    <Hero />
    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-label">Selected work</h2>
      {
        projects.map((project, index) => (
          <ProjectBlock
            project={project}
            eager={index === 0}
            tint={tints[project.data.name] ?? "violet"}
            index={index}
          />
        ))
      }
      <a class="more-work" href="https://github.com/khatrihemang07" target="_blank" rel="noopener">See more of my work on GitHub →</a>
    </section>
    <About />
    <Contact />
  </main>
  <Dock />
  <Ruler projects={projects} />
</BaseLayout>
