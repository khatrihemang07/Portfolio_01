---
import { getCollection } from "astro:content";
import About from "../components/About.astro";
import Card from "../components/Card.astro";
import Contact from "../components/Contact.astro";
import Dock from "../components/Dock.astro";
import Hero from "../components/Hero.astro";
import Ruler from "../components/Ruler.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name),
);

const tints: Record<string, "pink" | "violet" | "teal"> = {
  markuli: "pink",
  Mnemora: "violet",
  localAIWrapper: "teal",
};
---

<BaseLayout>
  <main id="main">
    <Hero projectCount={projects.length} />
    <section id="work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="section-label">Selected work</h2>
      <div class="bento work-grid">
        {
          projects.map((project, index) => (
            <Card
              project={project}
              eager={index === 0}
              wide={index === 0}
              tint={tints[project.data.name] ?? "violet"}
              index={3 + index}
            />
          ))
        }
      </div>
    </section>
    <About />
    <Contact />
  </main>
  <Dock />
  <Ruler projects={projects} />
</BaseLayout>
